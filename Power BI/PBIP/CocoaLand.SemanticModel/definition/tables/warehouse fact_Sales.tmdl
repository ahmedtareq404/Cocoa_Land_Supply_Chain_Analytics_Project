table 'warehouse fact_Sales'
	lineageTag: 8fa7865e-d1ce-46df-9548-72e130b37a35

	measure 'DIFOT %' =
			
			DIVIDE(
			    CALCULATE(
			        DISTINCTCOUNT('warehouse fact_Sales'[Sales_Key]),
			        'warehouse fact_Sales'[Fulfillment_Status] = "Delivered",
			        'warehouse fact_Sales'[Fulfillment_Days] <= 21
			    ),
			    DISTINCTCOUNT('warehouse fact_Sales'[Sales_Key]),
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: ed2af71d-4f65-46f1-b8d9-d91719224e99

	measure 'Fill Rate %' = DIVIDE(CALCULATE(COUNT('warehouse fact_Sales'[Sales_Key]), 'warehouse fact_Sales'[Fulfillment_Status] IN {"Delivered", "Delivered with Delay"}), COUNT('warehouse fact_Sales'[Sales_Key]))
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: d4210618-e726-4df3-8aba-af0cb73b8c34

	measure 'Orders per Turn' = COUNT('warehouse fact_Sales'[Sales_Key])/'warehouse fact_RawMaterials_Inventory'[Inventory Turnover]
		formatString: 0.00
		lineageTag: ad12dc23-448c-4137-8ece-4d4ebfe26128

	measure 'Avg Fulfillment Days' = CALCULATE(AVERAGE('warehouse fact_Sales'[Fulfillment_Days]) , 'warehouse fact_Sales'[Fulfillment_Status] IN {"Delivered", "Delivered with Delay"})
		formatString: 0.00
		lineageTag: 91745316-470c-4656-be9f-a5d079af5620

	measure 'Customers by Cancelled' = CALCULATE(DISTINCTCOUNT('warehouse fact_Sales'[Customer_Key]), 'warehouse fact_Sales'[Fulfillment_Status] = "Cancelled")
		formatString: 0
		lineageTag: c4d8fdbd-c930-477d-815c-379219fe221c

	measure 'Customers by Delivered with Delay' = CALCULATE(DISTINCTCOUNT('warehouse fact_Sales'[Customer_Key]), 'warehouse fact_Sales'[Fulfillment_Status] = "Delivered with Delay")
		formatString: 0
		lineageTag: 20547670-f963-4f06-b094-12dc855c3399


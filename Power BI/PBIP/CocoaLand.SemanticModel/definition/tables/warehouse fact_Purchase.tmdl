table 'warehouse fact_Purchase'
	lineageTag: 43e2d9bb-2d3f-49cb-a2eb-852fd3f39b93

	measure 'Suppliers OTIF %' = DIVIDE(CALCULATE(COUNT('warehouse fact_Purchase'[Purchase_Orders_Key]), ('warehouse fact_Purchase'[PO_Status] = "Received")), CALCULATE(COUNT('warehouse fact_Purchase'[Purchase_Orders_Key])))
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: bac88c18-30d5-4178-b4cd-6aed6f178138

	measure 'Target OTIF %' = 0.85
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 84c9c3a4-18aa-426f-ab8d-e659699fc25b

	measure 'Reorder Rate %' =
			
			DIVIDE(
			    SUM('warehouse fact_Purchase'[Is_Repeated_PO]),
			    CALCULATE(
			        COUNTROWS('warehouse fact_Purchase'),
			        'warehouse fact_Purchase'[PO_Status] <> "Cancelled"
			    ),
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 5d1984da-38e8-4878-9942-fb7841cfe7d4

	measure 'Total PO Lines' =
			
			COUNT('warehouse fact_Purchase'[PO_Line_ID])
		formatString: 0
		lineageTag: 24417e8c-ad84-462f-8a45-e7795e80d9fa

	measure 'Target Reorder Rate %' = 0.40
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 28b734ba-5489-4544-a374-34efe740fb56

	measure 'Order Waste %' = DIVIDE(CALCULATE(COUNT('warehouse fact_Purchase'[Purchase_Orders_Key]), 'warehouse fact_Purchase'[PO_Status]="Cancelled"), COUNT('warehouse fact_Purchase'[Purchase_Orders_Key]), 0)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: c8503a12-7a93-4461-b4e6-4803e9a3b070

	measure 'Process Waste %' =
			
			(
			    [Order Waste %] * 0.4
			)
			+
			(
			    [Procurement Waste %] * 0.6
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: cda4f94a-93ef-4060-9212-8af41b1d70d4

	measure 'Target Process Waste %' = 0.080
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 42103353-7bf3-4456-80f5-97ad77fb9562

	measure 'Delivered Orders' = CALCULATE(COUNT('warehouse fact_Purchase'[Purchase_Orders_Key]), 'warehouse fact_Purchase'[PO_Status] <> "Cancelled")
		formatString: 0
		lineageTag: b2b94aca-517b-48fa-a2aa-d7da37017d33

	measure 'Successful Delivery Rate' = [Delivered Orders]/COUNT([Purchase_Orders_Key])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: d9b4b66f-3ef5-459f-86ec-712599dadf85


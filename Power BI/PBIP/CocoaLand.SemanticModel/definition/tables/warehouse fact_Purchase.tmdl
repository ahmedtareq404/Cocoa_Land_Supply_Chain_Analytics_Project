	column Total_PO_USD
		dataType: double
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 757fd7f8-4618-429e-aefe-38110bef837f
		summarizeBy: none
		sourceColumn: Total_PO_USD

		annotation SummarizationSetBy = User

	column Delivery_Days =
			
			VAR OrderDate = LOOKUPVALUE('warehouse dim_Date'[Full_Date], 'warehouse dim_Date'[Date_Key], 'warehouse fact_Purchase'[Order_Date_Key])
			
			VAR DeliveryDate = LOOKUPVALUE('warehouse dim_Date'[Full_Date], 'warehouse dim_Date'[Date_Key], 'warehouse fact_Purchase'[Delivery_Date_Key])
			
			RETURN DATEDIFF(OrderDate, DeliveryDate, DAY)
		formatString: 0
		lineageTag: 4dc5367b-5948-4192-aaf5-2a6116dc2dca
		summarizeBy: none

		annotation SummarizationSetBy = User

	column Is_Repeated_PO =
			
			VAR CurrentSupplier =
			    'warehouse fact_Purchase'[Supplier_Key]
			
			VAR CurrentMaterial =
			    'warehouse fact_Purchase'[Material_Key]
			
			VAR CurrentDate =
			    'warehouse fact_Purchase'[Order_Date_key]
			
			VAR CurrentStatus =
			    'warehouse fact_Purchase'[PO_Status]
			
			VAR FutureOrders =
			    CALCULATE(
			        COUNTROWS('warehouse fact_Purchase'),
			
			        FILTER(
			            ALL('warehouse fact_Purchase'),
			
			            'warehouse fact_Purchase'[Supplier_Key] = CurrentSupplier
			                &&
			            'warehouse fact_Purchase'[Material_Key] = CurrentMaterial
			                &&
			            'warehouse fact_Purchase'[Order_Date_Key] > CurrentDate
			                &&
			            'warehouse fact_Purchase'[Order_Date_Key] <= CurrentDate + 30
			                &&
			            'warehouse fact_Purchase'[PO_Status] <> "Cancelled"
			        )
			    )
			
			RETURN
			IF(
			    CurrentStatus <> "Cancelled"
			        &&
			    FutureOrders > 0,
			    1,
			    0
			)
		formatString: 0
		lineageTag: 94816da2-35cb-4023-be6e-cf7c0d4ae49e
		summarizeBy: none

		annotation SummarizationSetBy = User

	column 'RM Total Purchase Value' = 'warehouse fact_Purchase'[Line_Total_USD]/10
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: ccc6b870-ea71-4976-97c0-7fd4891e702b
		summarizeBy: none

		annotation SummarizationSetBy = User

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	column 'Qty of Defective RM (Tons)' = (IF('warehouse fact_Purchase'[PO_Status] <> "Cancelled", 'warehouse fact_Purchase'[Quantity] * RELATED('warehouse dim_Suppliers'[Defect Rate %]), BLANK()))/10000
		lineageTag: b774067f-d974-4bb2-81fa-2662f8914629
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}


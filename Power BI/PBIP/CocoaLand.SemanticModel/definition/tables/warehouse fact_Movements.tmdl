	column Reference
		dataType: string
		lineageTag: f2b1b9b0-f9cd-4560-8242-14743db2ea27
		summarizeBy: none
		sourceColumn: Reference

		annotation SummarizationSetBy = Automatic

	column 'Qty of RM Moved (Tons) for Sales' = IF('warehouse fact_Movements'[Reference]="Sales Fulfillment",('warehouse fact_Movements'[Quantity_RM])/10)
		lineageTag: 56951f9a-72f2-4497-a72d-7f1a0342c5fd
		summarizeBy: none

		annotation SummarizationSetBy = User

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Qty of Prod Moved (Tons)' =
			VAR TotalWeight_g =
			    'warehouse fact_Movements'[Quantity_Prod] *
			    RELATED('warehouse dim_Products'[Weight_g])
			
			RETURN
			    DIVIDE(TotalWeight_g, 1000000)
		formatString: 0.000
		lineageTag: cc067ddf-d7a9-4599-9762-3aff1791456f
		summarizeBy: none

		annotation SummarizationSetBy = User

	column 'Moved RM Value USD' = 'warehouse fact_Movements'[OUT RM Qty] * RELATED('warehouse dim_Raw_Materials'[Unit_Cost_USD])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 7bbc3538-c060-45fa-b08f-3ca50da980a7
		summarizeBy: none

		annotation SummarizationSetBy = User

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	partition 'warehouse fact_Movements' = m
		mode: import
		source =
				let
				    Source = Sql.Database("DESKTOP-86K64M9\TEW_SQLEXPRESS", "CocoaLand_DB"),
				    warehouse_fact_Movements = Source{[Schema="warehouse",Item="fact_Movements"]}[Data]
				in
				    warehouse_fact_Movements

	annotation PBI_ResultType = Table


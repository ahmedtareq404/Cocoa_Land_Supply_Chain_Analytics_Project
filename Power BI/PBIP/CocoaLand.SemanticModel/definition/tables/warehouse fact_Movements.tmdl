table 'warehouse fact_Movements'
	lineageTag: 87b37265-f4be-4952-93ab-62a9d7da8e28

	measure 'IN Movements' = CALCULATE(COUNT('warehouse fact_Movements'[Movement_Key]), 'warehouse fact_Movements'[Movement_Type] = "IN")
		formatString: 0
		lineageTag: 2f091e48-2971-4159-b909-d7f99af85985

	measure 'OUT Movements' = CALCULATE(COUNT('warehouse fact_Movements'[Movement_Key]), 'warehouse fact_Movements'[Movement_Type] = "OUT")
		formatString: 0
		lineageTag: bd2b7d10-0bc5-4a45-a1c3-73e4421547b0

	measure 'IN Prod Qty' = CALCULATE(SUM('warehouse fact_Movements'[Qty of Prod Moved (Tons)]), 'warehouse fact_Movements'[Movement_Type] = "IN")
		formatString: 0
		lineageTag: 8c0afef4-a0e6-4e03-9651-08ac59541dac

	measure 'IN RM Qty' = CALCULATE(SUM('warehouse fact_Movements'[Qty of RM Moved (Tons) for Sales]), 'warehouse fact_Movements'[Movement_Type] = "IN")
		formatString: 0
		lineageTag: 0a9a186c-632a-474c-9345-9c60e10d60a1

	measure 'OUT RM Qty' = CALCULATE(SUM('warehouse fact_Movements'[Qty of RM Moved (Tons) for Sales]), 'warehouse fact_Movements'[Movement_Type] = "OUT")
		formatString: 0
		lineageTag: 107731ae-0ee6-498d-90da-926126093a08

	measure 'OUT Prod Qty' = CALCULATE(SUM('warehouse fact_Movements'[Qty of Prod Moved (Tons)]), 'warehouse fact_Movements'[Movement_Type] = "OUT")
		formatString: 0
		lineageTag: d95f4d06-06e2-4d50-bc7b-c0e6076bdbe2

	measure 'Total IN Qty' = ('warehouse fact_Movements'[IN Prod Qty]) + ('warehouse fact_Movements'[IN RM Qty])
		formatString: 0.00
		lineageTag: 670f69a5-8e77-4edb-b83d-169c3e1a1dea

	measure 'Total OUT Qty' = ('warehouse fact_Movements'[OUT Prod Qty]) + ('warehouse fact_Movements'[OUT RM Qty])
		formatString: 0.00
		lineageTag: 386b4495-cf0a-455b-b601-d051d78ec17c

	measure Shrinkage% =
			
			ABS(DIVIDE(([Expected Overall Qty]-[Overall Current Stock (Tons)]), [Expected Overall Qty]))/10
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 66428ada-ee73-470f-b3e3-1fbbe2c4f805

	measure 'Target Shrinkage%' = 0.10
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: a5d6e14b-17f1-4ce9-8e4b-62d7b91466ca

	measure Variance% = DIVIDE(([Overall Current Stock (Tons)]-[Expected Overall Qty]), [Expected Overall Qty])/10
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 550baa66-920d-4fe7-adbb-a7b7dd6c5ddc

	measure 'COGS USD' = SUM('warehouse fact_Movements'[Moved RM Value USD])
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: db896aad-4a89-45a1-9c9f-3dbce7368beb

	measure 'Target Variance %' = 0.10
		lineageTag: 1b3fceda-8330-49ec-82ed-560928340e08

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Expected Overall Qty' = [Total IN Qty]-[Total OUT Qty]
		lineageTag: 818e13ab-6925-4cc5-bf7f-56d84791f6eb

		annotation PBI_FormatHint = {"isGeneralNumber":true}


table 'warehouse dim_Warehouse_Master'
	lineageTag: d5fd8ce9-7abe-4acd-909b-e70a274b5e11

	measure 'Overall Current Stock (Tons)' =
			
			SUM('warehouse fact_Products_Inventory'[Current Stock Prod (Tons)]) + SUM('warehouse fact_RawMaterials_Inventory'[Current Stock RM (Tons)])
		formatString: 0.00
		lineageTag: 5ea29acb-5f3f-4b2a-b84a-f63bf6672a4d

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "MathematicalAddition"
				}

		changedProperty = FormatString

	measure 'Total Warehouse Capacities' = SUM('warehouse dim_Warehouse_Master'[Capacity_MT])
		formatString: 0
		lineageTag: 43e087f5-9a07-42f6-a8e1-736097f56017

	measure 'Capacity Utilisation %' = DIVIDE('warehouse dim_Warehouse_Master'[Overall Current Stock (Tons)], 'warehouse dim_Warehouse_Master'[Total Warehouse Capacities])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 8e1aa860-02fb-4b34-89f4-9e9fdac14deb

	measure 'Target Capacity Utilisation %' = 0.80
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: fa336d7b-298c-44fc-8d92-40cf95cae4bd


	column 'Current Stock RM (Tons)' = 'warehouse fact_RawMaterials_Inventory'[Current_Stock_RM]/10000
		dataType: int64
		formatString: 0
		lineageTag: bd8c8596-cc78-4044-9c51-4b344c478b39
		summarizeBy: none

		changedProperty = DataType

		annotation SummarizationSetBy = User

		annotation PBI_FormatHint = {"isDecimal":true}

	column 'Inventory Value' = ('warehouse fact_RawMaterials_Inventory'[Current_Stock_RM]*RELATED('warehouse dim_Raw_Materials'[Unit_Cost_USD]))/ 100
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 76a85b03-d1a3-45de-916b-49760887fd48
		summarizeBy: none

		annotation SummarizationSetBy = User


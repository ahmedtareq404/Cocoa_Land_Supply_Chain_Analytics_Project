table 'warehouse fact_RawMaterials_Inventory'
	lineageTag: 1708eef0-1725-444b-b2ed-deb308711926

	measure 'Procurement Waste %' = (SUM('warehouse fact_RawMaterials_Inventory'[Current Stock RM (Tons)])/SUM('warehouse fact_Products_Inventory'[Current Stock Prod (Tons)]))/1000
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: df5a933f-3a61-4c11-80e7-63921d4d6a3a

	measure 'Inventory Turnover' =
			
			DIVIDE(
			    'warehouse fact_Movements'[COGS USD],
			    CALCULATE(AVERAGE('warehouse fact_RawMaterials_Inventory'[Inventory Value])
			))/10
		formatString: 0.00
		lineageTag: cafd10ff-ea10-43c0-b880-da01c4e83082

	measure 'Target Inventory Turnover' = 5.00
		lineageTag: 045bc321-2ccb-45c7-a6a9-aec28fc50fc3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Material_Key
		dataType: int64
		formatString: 0
		lineageTag: a0ecbb84-d786-40d4-a318-0c7e5b4d6728
		summarizeBy: none
		sourceColumn: Material_Key

		annotation SummarizationSetBy = User

